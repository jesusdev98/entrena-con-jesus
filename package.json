{
  "name": "entrena-con-jesus",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && node scripts/finalize-build.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "eslint src e2e playwright.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium-mobile --project=chromium-desktop",
    "preview": "node scripts/serve-built.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "verify:static": "node scripts/verify-static.mjs",
    "validate:catalogs": "node scripts/catalogs/validate.mjs",
    "catalogs:foods": "node scripts/catalogs/build-foods.mjs",
    "validate:foods": "node scripts/catalogs/validate-foods.mjs",
    "test:foods": "node --test scripts/catalogs/food-data.test.mjs",
    "catalogs:exercises": "node scripts/catalogs/build-exercises.mjs",
    "validate:exercises": "node scripts/catalogs/validate-exercises.mjs",
    "test:exercises": "node --test scripts/catalogs/exercise-data.test.mjs",
    "catalogs:mets": "node scripts/catalogs/build-mets.mjs",
    "validate:mets": "node scripts/catalogs/validate-mets.mjs",
    "test:mets": "node --test scripts/catalogs/met-data.test.mjs"
  },
  "private": true,
  "engines": { "node": "24.19.x", "npm": "11.17.x" },
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/cdk": "22.1.6",
    "@angular/common": "22.1.6",
    "@angular/compiler": "22.1.6",
    "@angular/core": "22.1.6",
    "@angular/forms": "22.1.6",
    "@angular/platform-browser": "22.1.6",
    "@angular/router": "22.1.6",
    "@angular/service-worker": "22.1.6",
    "idb": "8.0.3",
    "pdfmake": "0.3.11",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@angular/build": "22.1.8",
    "@angular/cli": "22.1.8",
    "@angular/compiler-cli": "22.1.6",
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.63.0",
    "@vitest/coverage-v8": "4.1.11",
    "angular-eslint": "22.5.0",
    "eslint": "9.39.4",
    "fake-indexeddb": "6.2.4",
    "jsdom": "28.0.0",
    "prettier": "3.8.1",
    "typescript": "6.0.2",
    "typescript-eslint": "8.70.0",
    "vitest": "4.1.11"
  }
}
